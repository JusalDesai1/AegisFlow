# Environment Configuration
# Copy this file to .env.local and update values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3000
API_SECRET_KEY=your-secret-key-here

# Database (Supabase or PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/aegisflow
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/aegisflow

# Authentication
NEXT_PUBLIC_AUTH_DOMAIN=auth.aegisflow.gov
NEXT_AUTH_SECRET=your-auth-secret-here
NEXT_AUTH_URL=http://localhost:3000

# Redis (Caching & Queues)
REDIS_URL=redis://localhost:6379

# Mapbox (GIS Integration)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# AWS (Optional - S3 for file uploads)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_S3_BUCKET=aegisflow-bucket
AWS_REGION=us-east-1

# Twilio (SMS Fallback)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Analytics
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENV=development
