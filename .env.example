# Environment Variables Template
# Copy this to .env.local and fill in actual values

# Application Settings
NEXT_PUBLIC_APP_NAME=AegisFlow
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_API_TIMEOUT=30000

# Map Configuration - Get token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk_your_mapbox_token_here
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11

# Database (if using Supabase - https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# Authentication
NEXT_PUBLIC_AUTH_PROVIDER=local
NEXT_AUTH_SECRET=your_generated_secret_here
NEXT_AUTH_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_3D_GLOBE=true
NEXT_PUBLIC_ENABLE_SOCKET_IO=true
NEXT_PUBLIC_DEBUG_MODE=false

# Node Environment
NODE_ENV=development

# For Production Deployment on Vercel
# Uncomment and set these in Vercel dashboard:
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_API_URL=https://your-production-api.com
# NODE_ENV=production
